{
  "dbsyncconfig" : {
    "host"     : "${DBSYNC_POSTGRES_HOST}",
    "dbname"   : "${DBSYNC_DATABASE}",
    "user"     : "${DBSYNC_POSTGRES_USER:-postgres}",
    "password" : "${DBSYNC_POSTGRES_PASSWORD}",
    "port"     : ${DBSYNC_POSTGRES_PORT:-5432}
  },
  "port" : 8080,
  "host" : "0.0.0.0",
